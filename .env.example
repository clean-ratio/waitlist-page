# Copy to .env.local for local development, and add the same two variables in
# Vercel → Project → Settings → Environment Variables.
#
# Both are public by design (they ship in the page). Use the *publishable* key
# (sb_publishable_…, or the legacy "anon" key) — never the secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Confirmation email. SERVER-ONLY: never prefix these with VITE_ (that would
# ship them in the page). Here they are only read by `npm run email:test`. The
# live email is sent by the Supabase Edge Function, so set them there with
# `supabase secrets set`, not in Vercel. EMAIL_FROM defaults to
# "Clean Ratio <socials@clean-ratio.com>".
RESEND_API_KEY=
EMAIL_FROM=
